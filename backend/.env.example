# Copy to backend/.env and fill in. Never commit .env.
# The backend also reads the repo-root .env first (backend/.env wins), and accepts the
# prototype's VLLM_BASE_URL / VLLM_MODEL there (a trailing /v1 is stripped).

# Telegram api_id/api_hash are NOT set here. Each user enters their own on the login page.

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# vLLM via SSH tunnel (ssh -N -L 8000:localhost:8000 <user>@<gpu server>), without /v1.
# Usually http://127.0.0.1:8000. No API key: the tunnel is the access control.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SEC=30

# Use the stub AI implementation (no GPU server needed)
LLM_USE_STUB=true

DATABASE_URL=sqlite+aiosqlite:///./kirothon.db
