# Copy to backend/.env and fill in. Never commit .env.

# Telegram app credentials (https://my.telegram.org), shared by all users
API_ID=
API_HASH=

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# vLLM server (without /v1) and its --served-model-name
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SEC=30

# Use the stub AI implementation (no GPU server needed)
LLM_USE_STUB=true

DATABASE_URL=sqlite+aiosqlite:///./kirothon.db
