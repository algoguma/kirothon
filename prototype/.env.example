# 원격 서버 vLLM (SSH 터널: ssh -N -L 8000:localhost:8000 user@server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen3.8-27b
# 입력: 대화 앞에서부터 사용할 메시지 수
MAX_MESSAGES=1000
# 그중 최근 N개로 말투 분석
STYLE_MESSAGES=500
# 기억 추출 구간 크기
MEMORY_CHUNK=250
# 대화 시 프롬프트에 넣을 최근 원문 메시지 수
RECENT_RAW=150
# style.md / memory.md 저장 위치
OUTPUT_DIR=output
# SSH 자동 터널: 설정하면 run.sh/app.py/main.py 실행 시 vLLM 서버로 터널을 자동으로 엽니다
#SSH_TUNNEL=user@server-ip
# (선택) 터널 전용 키. 없으면 실행 시 SSH 비밀번호를 물어봅니다
#SSH_KEY=~/.ssh/kirothon
#SSH_PORT=22
#SSH_REMOTE_PORT=8000
# (선택) SSH 비밀번호. 넣으면 비밀번호 프롬프트 없이 터널을 엽니다. 이 값이 들어간 .env는 절대 공유/업로드 금지
#SSH_PASSWORD=
