# 원격 서버 vLLM (SSH 터널: ssh -N -L 8000:localhost:8000 user@server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen3.8-27b
# 입력: 대화 앞에서부터 사용할 메시지 수
MAX_MESSAGES=1000
# 그중 최근 N개로 말투 분석
STYLE_MESSAGES=500
# 기억 추출 구간 크기
MEMORY_CHUNK=250
# 대화 시 프롬프트에 넣을 최근 원문 메시지 수
RECENT_RAW=150
# style.md / memory.md 저장 위치
OUTPUT_DIR=output
