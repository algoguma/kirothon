# Copy to frontend/.env.local, then restart `npm.cmd run dev`.
# Which API groups use mock data (src/api/mock.ts) instead of the backend:
#   true            -> all mock (no backend needed)
#   false           -> all real backend (127.0.0.1:8080)
#   chats,sessions  -> real login, mock for the rest (until the backend has those APIs)
# Groups: auth, chats, sessions
VITE_USE_MOCK=true
